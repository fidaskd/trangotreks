---
import Logo from './Logo.astro';
import { CONTACT_EMAIL, EXPEDITIONS, SITE_DESCRIPTION } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container grid">
		<div class="brand">
			<Logo inverse />
			<p>{SITE_DESCRIPTION}</p>
		</div>

		<div>
			<h4>Expeditions</h4>
			<ul>
				{EXPEDITIONS.map((e) => <li><a href={`/#${e.slug}`}>{e.name}</a></li>)}
			</ul>
		</div>

		<div>
			<h4>Explore</h4>
			<ul>
				<li><a href="/blog">Journal</a></li>
				<li><a href="/about">About us</a></li>
				<li><a href="/rss.xml">RSS feed</a></li>
			</ul>
		</div>

		<div>
			<h4>Get in touch</h4>
			<ul>
				<li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
				<li>Gilgit-Baltistan, Pakistan</li>
			</ul>
		</div>
	</div>

	<div class="container bottom">
		<span>&copy; {year} Trango Treks. All rights reserved.</span>
		<span>Leave only footprints.</span>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--ink);
		color: var(--mist);
		padding-top: clamp(3.5rem, 7vw, 5rem);
		font-size: 0.95rem;
	}
	.grid {
		display: grid;
		grid-template-columns: 1.6fr repeat(3, 1fr);
		gap: 2.5rem;
		padding-bottom: 3rem;
	}
	.brand p {
		max-width: 30ch;
		margin-top: 1rem;
	}
	h4 {
		margin-bottom: 1rem;
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--paper);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}
	a {
		color: var(--mist);
		text-decoration: none;
	}
	a:hover {
		color: var(--paper);
	}
	.bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		padding-block: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		font-size: 0.85rem;
	}
	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
		.brand {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 480px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
