---
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';

interface Props {
	/** Transparent header that sits over a dark hero. */
	overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<header class:list={['site-header', { overlay }]} data-header>
	<nav class="container nav" aria-label="Main">
		<Logo inverse={overlay} />

		<input type="checkbox" id="nav-toggle" class="nav-toggle sr-only" />
		<label for="nav-toggle" class="burger" aria-label="Toggle menu">
			<span></span><span></span><span></span>
		</label>

		<div class="menu">
			<HeaderLink href="/#expeditions">Expeditions</HeaderLink>
			<HeaderLink href="/blog">Journal</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/#plan" class="btn btn-primary menu-cta">Plan your trip</a>
		</div>
	</nav>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	if (header) {
		const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}
	document.querySelectorAll<HTMLAnchorElement>('.menu a').forEach((a) =>
		a.addEventListener('click', () => {
			const t = document.getElementById('nav-toggle') as HTMLInputElement | null;
			if (t) t.checked = false;
		}),
	);
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		color: var(--ink);
		background: rgba(247, 244, 238, 0.88);
		backdrop-filter: saturate(1.4) blur(12px);
		-webkit-backdrop-filter: saturate(1.4) blur(12px);
		border-bottom: 1px solid rgba(14, 26, 34, 0.06);
		transition:
			background-color 0.3s ease,
			color 0.3s ease,
			border-color 0.3s ease;
	}
	.site-header.overlay {
		position: fixed;
		left: 0;
		right: 0;
		color: var(--paper);
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		border-bottom-color: transparent;
	}
	.site-header.overlay.scrolled {
		background: rgba(14, 26, 34, 0.82);
		backdrop-filter: saturate(1.4) blur(12px);
		-webkit-backdrop-filter: saturate(1.4) blur(12px);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 76px;
	}
	.menu {
		display: flex;
		align-items: center;
		gap: 2rem;
	}
	.menu-cta {
		padding: 0.7em 1.25em;
		font-size: 0.9rem;
	}
	.burger {
		display: none;
	}

	@media (max-width: 760px) {
		.burger {
			display: grid;
			gap: 5px;
			padding: 10px;
			margin-right: -10px;
			cursor: pointer;
		}
		.burger span {
			display: block;
			width: 22px;
			height: 2px;
			background: currentColor;
			border-radius: 2px;
			transition:
				transform 0.25s ease,
				opacity 0.25s ease;
		}
		.menu {
			position: absolute;
			top: 76px;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.5rem var(--gutter) 1.5rem;
			background: var(--ink);
			color: var(--paper);
			box-shadow: var(--shadow-lg);
			transform: translateY(-8px);
			opacity: 0;
			visibility: hidden;
			transition:
				opacity 0.2s ease,
				transform 0.2s ease,
				visibility 0.2s;
		}
		.menu :global(.nav-link) {
			padding: 0.9rem 0;
			border-bottom: 1px solid rgba(255, 255, 255, 0.08);
			font-size: 1.05rem;
		}
		.menu :global(.nav-link::after) {
			display: none;
		}
		.menu-cta {
			margin-top: 1.25rem;
			padding: 1em;
		}
		.nav-toggle:checked ~ .menu {
			opacity: 1;
			transform: none;
			visibility: visible;
		}
		.nav-toggle:checked + .burger span:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}
		.nav-toggle:checked + .burger span:nth-child(2) {
			opacity: 0;
		}
		.nav-toggle:checked + .burger span:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}
	}
</style>
