---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & { eyebrow?: string; showDate?: boolean };

const { title, description, pubDate, updatedDate, heroImage, eyebrow = 'Journal', showDate = true } =
	Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} · Trango Treks`} description={description} image={heroImage} />
		<style>
			.post-head {
				padding-block: clamp(3rem, 7vw, 5rem) clamp(2rem, 4vw, 3rem);
				text-align: center;
			}
			.post-head .eyebrow {
				justify-content: center;
			}
			.post-head h1 {
				max-width: 18ch;
				margin-inline: auto;
				font-size: clamp(2.2rem, 5vw, 3.8rem);
				font-weight: 500;
			}
			.post-head .desc {
				max-width: 36em;
				margin: 0 auto;
				font-size: 1.15rem;
				color: var(--slate);
			}
			.meta {
				margin-top: 1.25rem;
				font-size: 0.9rem;
				color: var(--mist);
			}
			.meta .updated {
				display: block;
				font-style: italic;
			}
			.hero-image {
				max-width: 1100px;
				margin-inline: auto;
				padding-inline: var(--gutter);
			}
			.hero-image img {
				width: 100%;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-lg);
			}
			.body {
				max-width: 720px;
				margin-inline: auto;
				padding: clamp(2.5rem, 6vw, 4rem) var(--gutter) clamp(4rem, 9vw, 6rem);
			}
			.back {
				display: inline-flex;
				gap: 0.4em;
				margin-top: 3rem;
				font-weight: 600;
				text-decoration: none;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="container post-head">
					<p class="eyebrow">{eyebrow}</p>
					<h1>{title}</h1>
					{description && <p class="desc">{description}</p>}
					{
						showDate && (
							<p class="meta">
								<FormattedDate date={pubDate} />
								{updatedDate && (
									<span class="updated">
										Last updated on <FormattedDate date={updatedDate} />
									</span>
								)}
							</p>
						)
					}
				</header>
				{
					heroImage && (
						<div class="hero-image">
							<img width={1100} height={550} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="body">
					<div class="prose">
						<slot />
					</div>
					<a class="back" href="/blog"><span aria-hidden="true">←</span> Back to the journal</a>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
