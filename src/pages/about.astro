<Layout
	title="Rooted in the Karakoram"
	description="Who we are, how we work, and why we keep going back to the mountains of Gilgit-Baltistan."
	pubDate={new Date('August 08 2021')}
	heroImage="/blog-placeholder-about.jpg"
	eyebrow="About us"
